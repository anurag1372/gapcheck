# Copy to .env.local and fill in. Never commit .env.local.

# Claude: create a key at https://console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=
# A model ID from Anthropic's models list in the console
ANTHROPIC_MODEL=claude-opus-5-5

# Telegram: create a bot with @BotFather (/newbot) and paste the token
TELEGRAM_BOT_TOKEN=
# Run `npm run bot`, send /start to your bot, and paste the chat ID it replies with
TELEGRAM_CHAT_ID=
